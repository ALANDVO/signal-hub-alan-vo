# signal-hub-alan-vo Environment Configuration
# Copy to .env and fill in values. NEVER commit .env with real secrets.

# Application
APP_NAME=signal-hub-alan-vo
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Development: sqlite:///./signal_hub.db
# Production: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./signal_hub.db

# CORS (comma-separated origins for production)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=signal-hub
KEYCLOAK_CLIENT_ID=signal-hub-backend
KEYCLOAK_CLIENT_SECRET=

# LLM (optional, opt-in, server-side only)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# Sandbox execution
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=256m

# PostgreSQL (for docker compose)
POSTGRES_PASSWORD=changeme

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_DB_PASSWORD=changeme
KEYCLOAK_CLIENT_SECRET=changeme